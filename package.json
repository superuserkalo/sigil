{
  "name": "dl-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Sigil, a native Rust mod manager and workbench for Deadlock",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "vendor": "bash scripts/vendor-grimoire.sh",
    "vendor:rune": "./scripts/vendor-rune.sh",
    "vendor:tinyagent": "./scripts/vendor-tinyagent.sh",
    "rust:check": "cargo check --manifest-path rust/Cargo.toml --workspace",
    "rust:app": "cargo run --manifest-path rust/Cargo.toml -p dah-desktop",
    "rust:dah": "cargo run --manifest-path rust/Cargo.toml -p dah-rs --",
    "rust:agent": "cargo run --manifest-path rust/Cargo.toml -p dah-agent"
  }
}
