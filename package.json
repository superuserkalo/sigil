{
  "name": "dl-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Agentic modding workbench for Deadlock",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "bash scripts/test.sh",
    "dah": "pnpm --filter @dah/cli exec tsx src/index.ts",
    "vendor": "bash scripts/vendor-grimoire.sh"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
