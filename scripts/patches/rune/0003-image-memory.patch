+    /// Stages a write of a `width`-texel-wide region of `texture` at (`x`, `y`). `rows` holds
+    /// its rows tightly packed; its length is a whole number of rows. A region taller than
+    /// [`REGION_SLICE`] bytes goes in slices, so one large image never needs one large chunk.
+    pub fn write_texture_region(&self, texture: &wgpu::Texture, x: u32, y: u32, width: u32, rows: &[u8]) {
+        let texel = texture.format().block_copy_size(None).expect("a color format");
+        let row = width * texel;
+        if row == 0 { return; }
+        let count = (rows.len() / row as usize) as u32;
+        if count == 0 { return; }
+        let mut s = self.lock();
+        if cfg!(target_arch = "wasm32") {
+            return s.queue.write_texture(
+                wgpu::TexelCopyTextureInfo { texture, mip_level: 0, origin: wgpu::Origin3d { x, y, z: 0 }, aspect: wgpu::TextureAspect::All },
+                rows,
+                wgpu::TexelCopyBufferLayout { offset: 0, bytes_per_row: Some(row), rows_per_image: None },
+                wgpu::Extent3d { width, height: count, depth_or_array_layers: 1 },
+            );
+        }
+        let padded = u64::from(row).next_multiple_of(ROW_ALIGN);
+        let per_slice = (REGION_SLICE / padded).max(1) as u32;
+        let mut first = 0;
+        while first < count {
+            let n = per_slice.min(count - first);
+            let size = padded * u64::from(n);
+            let src = &rows[(first * row) as usize..((first + n) * row) as usize];
+            let (buffer, at) = s.stage(size, ROW_ALIGN, self, |view| {
+                for (r, line) in src.chunks_exact(row as usize).enumerate() {
+                    let start = r * padded as usize;
+                    view.slice(start..start + line.len()).copy_from_slice(line);
+                }
+            });
+            s.pending.push(Pending { src: buffer, offset: at, size,
+                dst: Dst::Region { texture: texture.clone(), x, y: y + first, width, rows: n, bytes_per_row: padded as u32 } });
+            first += n;
+        }
+    }
