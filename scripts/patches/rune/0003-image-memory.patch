+impl Fit {
+    /// The size a `w`×`h` image decodes to, or `None` to keep it (no more than about 15% over).
+    pub fn target(self, w: u32, h: u32) -> Option<(u32, u32)> {
+        if w == 0 || h == 0 { return None; }
+        let ratio = |side: u32, of: u32| (side > 0).then(|| side as f64 / of as f64);
+        let scale = match self {
+            Fit::Cover(bw, bh) => match (ratio(bw, w), ratio(bh, h)) { (Some(a), Some(b)) => a.max(b), (a, b) => a.or(b)? },
+            Fit::Contain(bw, bh) => match (ratio(bw, w), ratio(bh, h)) { (Some(a), Some(b)) => a.min(b), (a, b) => a.or(b)? },
+        };
