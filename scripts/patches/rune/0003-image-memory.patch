+//! Image memory: decoded pixels leave the CPU once an atlas copied them, the atlas keeps to its
+//! budget, and oversized images are refused from their header.
+
+use std::sync::Arc;
+
+use super::*;
+use crate::image::ImageCache;
+
+/// A PNG of `w`×`h` with every pixel `rgba`.
+fn png(w: u32, h: u32, rgba: [u8; 4]) -> Vec<u8> {
+    let image = image::RgbaImage::from_pixel(w, h, image::Rgba(rgba));
+    let mut out = std::io::Cursor::new(Vec::new());
+    image.write_to(&mut out, image::ImageFormat::Png).unwrap();
+    out.into_inner()
+}
+
+#[test]
+fn a_decoded_image_drops_its_cpu_pixels_once_the_atlas_copied_it_and_decodes_again_after_eviction() {
+    let cache = ImageCache::new(Arc::new(|| {}));
+    let image = cache.load(png(300, 200, [10, 20, 30, 255]));
+    assert_eq!(image.wait(), Ok([300, 200]));
+    let pixels = image.pixels().clone();
+    assert!(pixels.has_pixels(), "decoded, not yet drawn");
+    let mut atlas = ImageAtlas::default();
+    let placed = atlas.place(&pixels, [300.0, 200.0]).expect("drawn");
+    for _ in 0..=RELEASE_AFTER_FRAMES {
+        assert_eq!(atlas.place(&pixels, [300.0, 200.0]), Some(placed), "still drawn from its slot");
+        atlas.end_frame();
+    }
+    assert!(!pixels.has_pixels(), "no CPU copy once the atlas holds it");
+    assert!(pixels.is_ready(), "the atlas still holds it");
+    assert_eq!(atlas.place(&pixels, [300.0, 200.0]), Some(placed), "drawn without pixels");
+    // The atlas lets the page go: the image is no longer ready, and drawing it asks for a decode.
+    atlas.forget_all();
+    assert!(!pixels.is_ready());
+    assert_eq!(atlas.place(&pixels, [300.0, 200.0]), None, "nothing to draw this frame");
+    assert_eq!(image.wait(), Ok([300, 200]));
+    assert!(pixels.has_pixels(), "decoded again");
+    assert!(atlas.place(&pixels, [300.0, 200.0]).is_some());
+}
+
+#[test]
+fn pixels_an_app_set_are_never_dropped() {
+    let px = Pixels::new();
+    px.set(4, 4, vec![9; 64]);
+    let mut atlas = ImageAtlas::default();
+    for _ in 0..20 {
+        atlas.place(&px, [4.0; 2]);
+        atlas.end_frame();
+    }
+    assert!(px.has_pixels());
+}
+
+#[test]
+fn a_scroll_through_500_images_keeps_the_atlas_within_its_budget() {
+    let cache = ImageCache::new(Arc::new(|| {}));
+    let budget = 8u64 << 20;
+    let mut atlas = ImageAtlas::default();
+    atlas.budget = Some((budget, budget));
+    atlas.gpu = true;
+    let images: Vec<_> = (0..500u32).map(|i| cache.load(png(200, 120, [i as u8, (i >> 8) as u8, 7, 255]))).collect();
+    let mut peak = 0;
+    // Six cards on screen, the window moves one card a frame.
+    for top in 0..images.len() - 6 {
+        for image in &images[top..top + 6] {
+            let pixels = image.pixels();
+            if atlas.place(pixels, [200.0, 120.0]).is_none() {
+                image.wait().unwrap();
+                atlas.place(pixels, [200.0, 120.0]).expect("placed once decoded");
+            }
+        }
+        atlas.end_frame();
+        let (shelf, large) = atlas.bytes();
+        peak = peak.max(shelf + large);
+    }
+    assert!(peak <= budget, "atlas peaked at {peak} bytes over a {budget} byte budget");
+    let decoded = images.iter().filter(|i| i.pixels().has_pixels()).count();
+    assert!(decoded <= 6 + RELEASE_AFTER_FRAMES as usize, "{decoded} images still hold CPU pixels");
+}
+
+#[test]
+fn an_image_over_the_decode_limit_is_refused_from_its_header() {
+    // A PNG signature and an IHDR saying 9000 by 9000, and no pixel data at all: a decode that
+    // got past the header would fail on the missing data, not on the size.
+    let mut bytes = b"\x89PNG\r\n\x1a\n".to_vec();
+    let mut ihdr = b"IHDR".to_vec();
+    ihdr.extend_from_slice(&9000u32.to_be_bytes());
+    ihdr.extend_from_slice(&9000u32.to_be_bytes());
+    ihdr.extend_from_slice(&[8, 6, 0, 0, 0]);
+    let crc = !ihdr.iter().fold(!0u32, |c, &b| (0..8).fold(c ^ b as u32, |c, _| (c >> 1) ^ (0xedb8_8320 & 0u32.wrapping_sub(c & 1))));
+    bytes.extend_from_slice(&13u32.to_be_bytes());
+    bytes.extend_from_slice(&ihdr);
+    bytes.extend_from_slice(&crc.to_be_bytes());
+    // An empty IDAT ends the header the decoder reads; no pixel data follows.
+    bytes.extend_from_slice(&[0, 0, 0, 0, b'I', b'D', b'A', b'T', 0x35, 0xaf, 0x06, 0x1e]);
+    let cache = ImageCache::new(Arc::new(|| {}));
+    let error = cache.load(bytes.clone()).wait().unwrap_err().0.clone();
+    assert!(error.contains("over the decode limit"), "{error}");
+    let lazy = ImageCache::new(Arc::new(|| {})).decode_when_drawn(true);
+    let error = lazy.load(bytes).wait().unwrap_err().0.clone();
+    assert!(error.contains("over the decode limit"), "{error}");
+}
+
+#[test]
+fn a_lazy_cache_reads_the_size_and_decodes_only_when_drawn_or_prefetched() {
+    let (tx, rx) = std::sync::mpsc::channel();
+    let cache = ImageCache::new(Arc::new(move || { let _ = tx.send(()); })).decode_when_drawn(true);
+    let image = cache.file_fit(write_temp("lazy.png", &png(800, 400, [1, 2, 3, 255])), crate::image::Fit::Cover(200, 0));
+    rx.recv_timeout(std::time::Duration::from_secs(30)).unwrap();
+    assert_eq!(image.size(), Some([200, 100]), "the header, scaled to the fit");
+    assert!(!image.pixels().has_pixels(), "nothing decoded");
+    let mut atlas = ImageAtlas::default();
+    assert_eq!(atlas.place(image.pixels(), [200.0, 100.0]), None, "the first draw asks for it");
+    rx.recv_timeout(std::time::Duration::from_secs(30)).unwrap();
+    assert!(image.pixels().has_pixels());
+    let placed = atlas.place(image.pixels(), [200.0, 100.0]).unwrap();
+    assert_eq!(&placed.rect[2..], &[200, 100], "decoded at the fitted size");
+}
+
+fn write_temp(name: &str, bytes: &[u8]) -> std::path::PathBuf {
+    let dir = std::env::temp_dir().join(format!("rune-image-memory-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    let path = dir.join(name);
+    std::fs::write(&path, bytes).unwrap();
+    path
+}
+
+/// A GIF header (logical screen `w`×`h`, no global palette) followed by its trailer: the size is
+/// all a decoder can read, no frame follows.
+fn gif_header(w: u16, h: u16) -> Vec<u8> {
+    let mut bytes = b"GIF89a".to_vec();
+    bytes.extend_from_slice(&w.to_le_bytes());
+    bytes.extend_from_slice(&h.to_le_bytes());
+    bytes.extend_from_slice(&[0, 0, 0, 0x3b]);
+    bytes
+}
+
+#[test]
+fn an_animated_image_over_the_decode_limit_is_refused_from_its_header() {
+    // Under the 8192 a side animations always had, over a 4096 by 4096 limit (an app's, as
+    // Sigil's): the animation path checks the limit too, before any frame decodes.
+    crate::image::set_max_decode_pixels(4096 * 4096);
+    let bytes = gif_header(8000, 4000);
+    assert!(crate::image::animated::decode(&bytes).is_some_and(|r| r.is_err_and(|e| e.0.contains("over the decode limit"))));
+    let cache = ImageCache::new(Arc::new(|| {}));
+    let error = cache.load(bytes.clone()).wait().unwrap_err().0.clone();
+    assert!(error.contains("over the decode limit"), "{error}");
+    let fitted = cache.load_fit(bytes, crate::image::Fit::Cover(256, 0)).wait().unwrap_err().0.clone();
+    assert!(fitted.contains("over the decode limit"), "{fitted}");
+}
