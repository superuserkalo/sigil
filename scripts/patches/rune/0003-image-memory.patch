+/// Sets the atlas budgets in bytes of GPU texture: `shelf` for pages of small images, `total`
+/// for all pages. Pages drawn in the last few frames are kept even over budget.
+pub fn set_image_budget(shelf: u64, total: u64) {
+    SHELF_BUDGET.store(shelf, Ordering::Relaxed);
+    TOTAL_BUDGET.store(total.max(shelf), Ordering::Relaxed);
