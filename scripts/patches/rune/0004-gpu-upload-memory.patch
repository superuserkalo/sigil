+    /// The GPU allocator's report (D3D12 and Vulkan; `None` on Metal, which doesn't
+    /// suballocate) as text: reserved and used bytes, each block with its allocation count, and
+    /// the largest allocations by name. Kept as the last report ([`gpu_allocator_report`]) for
+    /// the app to log.
+    pub fn capture_allocator_report(device: &wgpu::Device, when: &str) -> Option<String> {
+        let report = device.generate_allocator_report()?;
+        let mb = |b: u64| format!("{:.1} MB", b as f64 / 1_048_576.0);
+        let mut out = format!("gpu allocator at {when}: reserved {}, used {}, {} blocks, {} allocations\nblocks:",
+            mb(report.total_reserved_bytes), mb(report.total_allocated_bytes), report.blocks.len(), report.allocations.len());
+        for block in &report.blocks {
+            let used: u64 = report.allocations[block.allocations.clone()].iter().map(|a| a.size).sum();
+            out.push_str(&format!(" [{} with {} in {}]", mb(block.size), mb(used), block.allocations.len()));
+        }
+        let mut big: Vec<_> = report.allocations.iter().collect();
+        big.sort_by_key(|a| std::cmp::Reverse(a.size));
+        out.push_str("\nlargest:");
+        for a in big.iter().take(12) { out.push_str(&format!(" [{} {}]", mb(a.size), a.name)); }
+        *LAST_ALLOCATOR_REPORT.lock().unwrap_or_else(|e| e.into_inner()) = Some(out.clone());
+        Some(out)
+    }
