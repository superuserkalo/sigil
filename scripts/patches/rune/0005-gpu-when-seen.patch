+/// Shows a hidden window minimized without activating it (`App::open_minimized`).
+fn show_minimized(window: &Window) {
+    use windows_sys::Win32::UI::WindowsAndMessaging::{SW_SHOWMINNOACTIVE, ShowWindow};
+    let Some(hwnd) = crate::platform::win32::hwnd(window) else { return };
+    // SAFETY: a window this thread owns.
+    unsafe { ShowWindow(hwnd, SW_SHOWMINNOACTIVE); }
+}
