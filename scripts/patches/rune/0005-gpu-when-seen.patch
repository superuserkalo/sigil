index a7bb53e..e43013f 100644
--- a/crates/rune/src/window/life_tests.rs
+++ b/crates/rune/src/window/life_tests.rs
@@ -37,3 +37,19 @@ fn a_hidden_window_closes_alike_whether_or_not_it_kept_its_window() {
     assert!(!Life::Unopened.closes(false, false), "nothing to close");
     assert!(Life::Unopened.closes(false, true) && !Life::Unopened.closes(true, true));
 }
+
+#[test]
+fn only_a_shown_uncovered_window_that_is_not_minimized_is_in_sight() {
+    // A login item started minimized, a window hidden to the tray and one covered whole by a
+    // game make no GPU until they show (`cpu_frame::gpu_owed`).
+    assert!(!Life::Unopened.in_sight(false));
+    assert!(!Life::Hidden { at: 1 }.in_sight(false));
+    assert!(!Life::Finished.in_sight(false));
+    let mut life = Life::Unopened;
+    assert!(life.show() && life.in_sight(false));
+    assert!(!life.in_sight(true), "minimized");
+    life.cover(Cover::Windows, true);
+    assert!(!life.in_sight(false), "covered whole");
+    life.cover(Cover::Windows, false);
+    assert!(life.in_sight(false), "back in sight");
+}
