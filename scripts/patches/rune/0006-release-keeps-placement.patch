+    /// Before a window is given up (`release`): the place and size it reopens at, and whether it
+    /// reopens maximized or full screen, as the user left it. A minimized window keeps what it
+    /// had (its rectangle is the system's minimized one), and a maximized or full screen one
+    /// keeps its last normal place and size, which leaving that state returns to.
+    fn keep_placement(&mut self) {
+        let Some(w) = &self.win else { return };
+        let window = &w.window;
+        if window.is_minimized() == Some(true) { return; }
+        let (maximized, full) = (window.is_maximized(), window.fullscreen().is_some());
+        self.reopen_as = Some(crate::windows::OpenAs::Normal.maximized(maximized).full_screen(full));
+        if maximized || full { return; }
+        if let Ok(p) = window.outer_position() { self.options.position = Some((p.x, p.y)); }
+        let size = window.inner_size();
+        if size.width > 0 && size.height > 0 && !self.rt.fit_height { self.options.physical_size = Some((size.width, size.height)); }
+    }
+
