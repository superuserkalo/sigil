+/// [`measure`] (`lend`). Outside one, the first [`measure`] on a thread builds that thread's own
+/// text system (every font, fallback and cache again), which an app that measures only while
+/// its views run never needs: it can keep what it measured there and answer from that instead.
+pub fn in_view() -> bool {
+    LENT.with(|l| !l.get().is_null())
+}
