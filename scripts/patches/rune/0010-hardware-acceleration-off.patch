+/// `decode_fitted`, then a Gaussian blur of `sigma` device pixels, still on the worker: no sharp
+/// pixel of the picture is ever handed on. An animation gives its first frame; AVIF and ICNS,
+/// which decode only whole, are refused.
+fn decode_blurred(bytes: &[u8], fit: Fit, sigma: f32) -> Result<Decoded, ImageError> {
+    let image = if is_svg(bytes) {
+        let (Fit::Cover(w, h) | Fit::Contain(w, h)) = fit;
+        let (w, h, rgba) = svg_rgba(bytes, w.max(h).clamp(1, 4096))?;
+        image::RgbaImage::from_raw(w, h, rgba).ok_or_else(|| ImageError("an SVG rendered to the wrong size".into()))?
+    } else if avif::is_avif(bytes) || bytes.starts_with(b"icns") {
+        return Err(ImageError("this format can't be decoded blurred".into()));
+    } else {
+        let mut image = decode_rgba(bytes)?;
+        if let Some((w, h)) = fit.target(image.width(), image.height()) {
+            image = image::imageops::resize(&image, w, h, image::imageops::FilterType::Triangle);
+        }
+        image
+    };
+    let sigma = if sigma.is_finite() { sigma.clamp(0.5, 64.0) } else { 0.5 };
+    let image = image::imageops::fast_blur(&image, sigma);
+    mip_chain(image.width(), image.height(), image.as_raw())
+}
