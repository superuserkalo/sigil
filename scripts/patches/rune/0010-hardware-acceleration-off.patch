+/// Whether DXGI lists a hardware adapter (one not flagged software: WARP and the Basic Render
+/// Driver are). Asked once and kept; it makes no device and loads no driver. True where it
+/// can't be asked, so only a clear no keeps a window off the GPU.
+#[cfg(target_os = "windows")]
+pub(crate) fn hardware_adapter() -> bool {
+    static HARDWARE: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *HARDWARE.get_or_init(|| {
+        use windows::Win32::Graphics::Dxgi::{CreateDXGIFactory1, DXGI_ADAPTER_FLAG_SOFTWARE, IDXGIFactory1};
+        // SAFETY: a DXGI factory and its adapters, asked for their descriptions only.
+        let Ok(factory) = (unsafe { CreateDXGIFactory1::<IDXGIFactory1>() }) else { return true };
+        (0..).map_while(|i| unsafe { factory.EnumAdapters1(i) }.ok())
+            .filter_map(|a| unsafe { a.GetDesc1() }.ok())
+            .any(|d| d.Flags & DXGI_ADAPTER_FLAG_SOFTWARE.0 as u32 == 0)
+    })
+}
