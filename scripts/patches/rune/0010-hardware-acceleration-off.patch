@@ -0,0 +1,46 @@
+//! A strict scene (`Scene::strict`, `App::hardware_acceleration(false)`) paints every frame on
+//! the CPU: what only the GPU draws degrades instead of being refused.
+
+use super::*;
+use bytemuck::Zeroable;
+
+use crate::render::{Instance, KIND_RECT, LayerSpec, NO_CLIP};
+
+fn rect(bounds: [f32; 4]) -> Instance {
+    Instance { rect: bounds, fill: [1.0; 4], clip: NO_CLIP, params: [0.0, KIND_RECT, 0.0, 1.0], ..Instance::zeroed() }
+}
+
+fn layer(bounds: [f32; 4], blur: f32) -> Vec<Instance> {
+    vec![Instance::begin_layer(bounds, NO_CLIP, LayerSpec { blur, ..Default::default() }), rect(bounds), Instance::end_layer()]
+}
+
+/// The pixel at (16, 16) of a 32 by 32 frame cleared to black, as B, G, R.
+fn centre(instances: &[Instance], strict: bool) -> Result<[u8; 3], NeedsGpu> {
+    let atlas = crate::text::TextSystem::default().atlas;
+    let images = crate::pixels::ImageAtlas::default();
+    let scene = Scene::new(instances, &atlas, &images, (32, 32), [0.0, 0.0, 0.0, 1.0]).strict(strict);
+    let mut buf = vec![0u8; 32 * 32 * 4];
+    paint(&scene, &mut Target::new(&mut buf, 32, 32), 1)?;
+    let at = (16 * 32 + 16) * 4;
+    Ok([buf[at], buf[at + 1], buf[at + 2]])
+}
+
+#[test]
+fn a_strict_scene_draws_a_blurred_layer_as_nothing_rather_than_ask_for_the_gpu() {
+    let blurred = layer([8.0, 8.0, 16.0, 16.0], 4.0);
+    assert_eq!(centre(&blurred, false), Err(NeedsGpu::LayerBlur), "a window that can hand over asks for the GPU");
+    assert_eq!(centre(&blurred, true), Ok([0, 0, 0]), "strict: what the blur obscures never shows sharp");
+    let plain = layer([8.0, 8.0, 16.0, 16.0], 0.0);
+    assert_eq!(centre(&plain, true), Ok([255, 255, 255]), "an unblurred layer still draws");
+}
+
+#[test]
+fn a_strict_scene_paints_what_only_the_gpu_draws_instead_of_refusing_it() {
