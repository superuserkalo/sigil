+
+/// A picture decoded blurred (`ImageCache::load_fit_blurred`) has no sharp pixel at any time:
+/// a hard black to white edge comes out as a ramp, at its fitted size.
+#[test]
+fn a_blurred_decode_hands_on_no_sharp_pixel() {
+    let mut picture = image::RgbaImage::from_pixel(128, 32, image::Rgba([0, 0, 0, 255]));
+    for y in 0..32 {
+        for x in 64..128 {
+            picture.put_pixel(x, y, image::Rgba([255, 255, 255, 255]));
+        }
+    }
+    let mut out = std::io::Cursor::new(Vec::new());
+    picture.write_to(&mut out, image::ImageFormat::Png).unwrap();
+    let bytes = out.into_inner();
+    let red_at = |image: &crate::image::Image, x: usize| {
+        let mips = image.pixels().mips().expect("decoded");
+        let top = &mips.mips[0];
+        assert_eq!((top.width, top.height), (64, 16), "fitted as `load_fit` would");
+        top.pixels[(8 * 64 + x) * 4]
+    };
+    let cache = ImageCache::new(Arc::new(|| {}));
+    let blurred = cache.load_fit_blurred(bytes.clone(), crate::image::Fit::Cover(64, 0), 3.0);
+    assert_eq!(blurred.wait(), Ok([64, 16]));
+    let (left, right) = (red_at(&blurred, 31), red_at(&blurred, 32));
+    assert!(left > 20 && left < 235 && right > 20 && right < 235, "the edge is a ramp: {left} {right}");
+    let sharp = cache.load_fit(bytes, crate::image::Fit::Cover(64, 0));
+    assert_eq!(sharp.wait(), Ok([64, 16]));
+    assert!(red_at(&sharp, 28) < 20 && red_at(&sharp, 35) > 235, "unblurred, the same picture keeps its edge");
+}
