+/// A GIF whose logical screen (its canvas) is `w`×`h`, holding one 1 by 1 frame: a file a
+/// decoder opens, so the canvas size is what refuses it. A header with no frame at all is
+/// refused for missing data before any size is checked, which proves nothing about the limit.
 fn gif_header(w: u16, h: u16) -> Vec<u8> {
     let mut bytes = b"GIF89a".to_vec();
     bytes.extend_from_slice(&w.to_le_bytes());
     bytes.extend_from_slice(&h.to_le_bytes());
-    bytes.extend_from_slice(&[0, 0, 0, 0x3b]);
+    // A two-colour global palette, a graphic control extension, a 1 by 1 image at the origin,
+    // its LZW data (minimum code size 2), and the trailer.
+    bytes.extend_from_slice(&[0x80, 0, 0, 0xff, 0xff, 0xff, 0, 0, 0]);
+    bytes.extend_from_slice(&[0x21, 0xf9, 0x04, 0x01, 0x0a, 0x00, 0x00, 0x00]);
+    bytes.extend_from_slice(&[0x2c, 0, 0, 0, 0, 1, 0, 1, 0, 0]);
+    bytes.extend_from_slice(&[0x02, 0x02, 0x44, 0x01, 0x00, 0x3b]);
     bytes
 }
 
