+/// An error that refuses an image for its size (a decode limit), not for anything else (a
+/// truncated file, a missing frame).
+fn refused_for_size(error: &str) -> bool {
+    let error = error.to_lowercase();
+    error.contains("limit") || error.contains("too large")
