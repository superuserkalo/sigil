@@ -0,0 +1,121 @@
+//! The arithmetic of Windows' custom frame (`platform::win32::frame`), apart from the Win32 calls
+//! so it is tested on every platform: the client rect `WM_NCCALCSIZE` returns for a restored and a
+//! maximized window, the outer size for a client size, and what a point in the client area hits.
+//!
+//! Windows 10 and the top inset. A restored window's client area starts at its outer top: no
+//! non-client row is left there, not even one pixel. On Windows 10 (builds before 22000), DWM
+//! paints either none of a captioned window's top frame or all of it: as soon as the top
+//! non-client inset is positive it draws the whole native title bar (caption, title and buttons)
+//! over the top of the window, on top of the app's own bar, while `GetClientRect` still reports a
+//! client area that starts one pixel down. Windows Terminal found the same
+//! (`NonClientIslandWindow::_UpdateFrameMargins`, "DWM only wants to draw either nothing or the
+//! whole top part of the frame") and keeps a 0 top inset too. The cost on Windows 10 is the 1 px
+//! system border along the top of a restored window, which DWM then does not draw; Windows 11
+//! draws that border over the client area anyway. Do not bring the 1 px row back.
+//!
+//! A maximized window hangs its frame off the display on every side. Its client area is the
+//! window's rect cut to the display's work area, so nothing is drawn under the screen's edge, on a
+//! display of any scale, including when the window maximizes onto a display whose scale differs
+//! from the one it was on (the frame thickness Windows used then is the new display's).
+
+#![cfg_attr(not(target_os = "windows"), allow(dead_code))]
+
+use crate::titlebar::{Caption, CaptionButton};
+
+/// A rectangle by its four edges in pixels (a Win32 `RECT`), or a frame's four border widths.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Edges {
+    pub left: i32,
+    pub top: i32,
+    pub right: i32,
+    pub bottom: i32,
+}
+
+impl Edges {
+    pub(crate) const fn new(left: i32, top: i32, right: i32, bottom: i32) -> Self {
+        Self { left, top, right, bottom }
+    }
+
+    fn is_empty(&self) -> bool {
+        self.right <= self.left || self.bottom <= self.top
+    }
+
+    fn intersect(&self, other: &Edges) -> Edges {
+        Edges { left: self.left.max(other.left), top: self.top.max(other.top), right: self.right.min(other.right), bottom: self.bottom.min(other.bottom) }
+    }
+}
+
+/// What a custom frame adds around a restored window's client area, given what the standard
+/// frame adds (`standard`, each edge a positive width): the sides and the bottom stay (they are
+/// the invisible resize borders), the top is 0 (see the module's note on Windows 10).
+pub(crate) fn restored_borders(standard: Edges) -> Edges {
+    Edges { top: 0, ..standard }
+}
+
+/// A restored window's client rect for `WM_NCCALCSIZE`: the default procedure's (`def_client`)
+/// sides and bottom, and the window's own top (`outer.top`).
+pub(crate) fn restored_client(outer: Edges, def_client: Edges) -> Edges {
+    Edges { top: outer.top, ..def_client }
+}
+
+/// A maximized window's client rect for `WM_NCCALCSIZE`: the window's new rect (`outer`) cut to
+/// the work area of the display it maximizes on (`work`). Without a work area (the query failed,
+/// or the window does not reach it), the default procedure's rect with the top moved down by the
+/// sizing border (`frame`) that hangs off the display.
+pub(crate) fn maximized_client(outer: Edges, def_client: Edges, frame: i32, work: Option<Edges>) -> Edges {
+    let fallback = Edges { top: outer.top + frame, ..def_client };
+    match work.map(|w| outer.intersect(&w)) {
+        Some(cut) if !cut.is_empty() => cut,
+        _ => fallback,
+    }
+}
+
+/// The outer size `(width, height)` of a restored window whose client area is `w` x `h` and whose
+/// standard frame adds `standard`.
+pub(crate) fn outer_size(w: i32, h: i32, standard: Edges) -> (i32, i32) {
+    let b = restored_borders(standard);
+    (w + b.left + b.right, h + b.top + b.bottom)
+}
+
+/// The outer size `WM_GETDPISCALEDSIZE` answers for a restored window whose client area is `w` x
+/// `h` at `old_dpi`, moving to `new_dpi`, where the standard frame adds `new_standard`.
+pub(crate) fn dpi_scaled_outer_size(w: i32, h: i32, old_dpi: u32, new_dpi: u32, new_standard: Edges) -> (i32, i32) {
+    let ratio = f64::from(new_dpi) / f64::from(old_dpi.max(1));
+    outer_size((f64::from(w) * ratio).round() as i32, (f64::from(h) * ratio).round() as i32, new_standard)
+}
+
+/// A `WM_GETMINMAXINFO` track height winit sized for a standard title bar (it changed it:
+/// `after != before`), with the top border this frame removes taken back off.
+pub(crate) fn track_height(before: i32, after: i32, standard: Edges) -> i32 {
+    if after == before { return after; }
+    let removed = standard.top - restored_borders(standard).top;
+    (after - removed).max(1)
+}
+
+/// What a point in the client area hits.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum ClientHit {
+    TopLeft,
+    Top,
+    TopRight,
+    Button(CaptionButton),
+    Client,
+}
+
+/// What the point `(x, y)` (client pixels) hits in a client area `width` pixels wide at `scale`:
+/// the top resize band (`edge` pixels tall, the sizing border's thickness) of a restored window
+/// that resizes, an enabled caption button, or the client.
+pub(crate) fn client_hit(caption: &Caption, width: i32, scale: f32, edge: i32, zoomed: bool, resizable: bool, (x, y): (i32, i32)) -> ClientHit {
+    if !zoomed && resizable && y >= 0 && y < edge {
+        return if x < edge { ClientHit::TopLeft } else if x >= width - edge { ClientHit::TopRight } else { ClientHit::Top };
+    }
+    let scale = if scale > 0.0 { scale } else { 1.0 };
+    match caption.hit(width as f32 / scale, scale, (x as f32 / scale, y as f32 / scale)) {
+        Some(button) => ClientHit::Button(button),
+        None => ClientHit::Client,
+    }
+}
+
+#[cfg(test)]
+#[path = "frame_math_tests.rs"]
+mod tests;
