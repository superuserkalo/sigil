new file mode 100644
index 0000000..08463f0
--- /dev/null
+++ b/crates/rune/src/platform/frame_math_tests.rs
@@ -0,0 +1,160 @@
+use super::*;
+use crate::titlebar::CaptionState;
+
+/// What a standard captioned, resizable frame adds at 100%: 8 px sizing borders (4 px frame and
+/// 4 px padding) and a 23 px caption above the top one.
+const STANDARD_100: Edges = Edges::new(8, 31, 8, 8);
+/// The same at 150%: 12 px sizing borders and a taller caption.
+const STANDARD_150: Edges = Edges::new(12, 46, 12, 12);
+
+fn deflate(outer: Edges, by: Edges) -> Edges {
+    Edges::new(outer.left + by.left, outer.top + by.top, outer.right - by.right, outer.bottom - by.bottom)
+}
+
+fn inflate(r: Edges, by: i32) -> Edges {
+    Edges::new(r.left - by, r.top - by, r.right + by, r.bottom + by)
+}
+
+fn caption() -> Caption {
+    Caption { height: 36.0, state: CaptionState::Idle, maximized: false, minimizable: true, maximizable: true, hidden: false, mirrored: false }
+}
+
+#[test]
+fn a_restored_window_has_no_top_inset_at_any_scale() {
+    for standard in [STANDARD_100, STANDARD_150] {
+        let outer = Edges::new(100, 50, 916, 658);
+        let def_client = deflate(outer, standard);
+        let client = restored_client(outer, def_client);
+        assert_eq!(client.top, outer.top, "any top inset makes Windows 10 paint its own title bar");
+        assert_eq!((client.left, client.right, client.bottom), (def_client.left, def_client.right, def_client.bottom), "the side and bottom resize borders stay");
+        let b = restored_borders(standard);
+        assert_eq!(b, Edges::new(standard.left, 0, standard.right, standard.bottom));
+    }
+}
+
+#[test]
+fn restored_sizes_round_trip_through_the_frame() {
+    // request_inner_size, then WM_NCCALCSIZE: the client area is the size asked for.
+    let (w, h) = outer_size(800, 600, STANDARD_100);
+    assert_eq!((w, h), (816, 608));
+    let outer = Edges::new(120, 80, 120 + w, 80 + h);
+    let client = restored_client(outer, deflate(outer, STANDARD_100));
+    assert_eq!((client.right - client.left, client.bottom - client.top), (800, 600));
+
+    let (w, h) = outer_size(1200, 900, STANDARD_150);
+    let outer = Edges::new(-1500, 200, -1500 + w, 200 + h);
+    let client = restored_client(outer, deflate(outer, STANDARD_150));
+    assert_eq!((client.right - client.left, client.bottom - client.top), (1200, 900));
+}
+
+#[test]
+fn a_scale_change_keeps_the_content_size_and_adds_no_top_border() {
+    assert_eq!(dpi_scaled_outer_size(800, 600, 96, 144, STANDARD_150), (1200 + 24, 900 + 12), "100% to 150%");
+    assert_eq!(dpi_scaled_outer_size(1200, 900, 144, 96, STANDARD_100), (800 + 16, 600 + 8), "150% to 100%");
+    assert_eq!(dpi_scaled_outer_size(100, 100, 0, 96, STANDARD_100), (9600 + 16, 9600 + 8), "an unknown old scale counts as 1 dpi, never divides by 0");
+}
+
+#[test]
+fn track_heights_lose_the_title_bar_winit_counted() {
+    let min = 680 + STANDARD_100.top + STANDARD_100.bottom;
+    assert_eq!(track_height(0, min, STANDARD_100), outer_size(1040, 680, STANDARD_100).1);
+    let min = 680 + STANDARD_150.top + STANDARD_150.bottom;
+    assert_eq!(track_height(0, min, STANDARD_150), outer_size(1040, 680, STANDARD_150).1);
+    assert_eq!(track_height(500, 500, STANDARD_100), 500, "a height winit left alone stays");
+    assert_eq!(track_height(0, 10, STANDARD_100), 1, "never below a pixel");
+}
+
+#[test]
+fn a_maximized_window_fills_the_work_area_and_nothing_hangs_off_it() {
+    // 100%, 1920 x 1080 with a 40 px taskbar at the bottom.
+    let work = Edges::new(0, 0, 1920, 1040);
+    let outer = inflate(work, 8);
+    let def_client = deflate(outer, STANDARD_100);
+    assert_eq!(maximized_client(outer, def_client, 8, Some(work)), work);
+    assert_eq!(maximized_client(outer, def_client, 8, None), work, "without the work area the sizing border comes off the top");
+
+    // 150%, a second display to the right, 2560 x 1440 with the taskbar's 60 px.
+    let work = Edges::new(1920, 0, 4480, 1380);
+    let outer = inflate(work, 12);
+    let def_client = deflate(outer, STANDARD_150);
+    assert_eq!(maximized_client(outer, def_client, 12, Some(work)), work);
+    assert_eq!(maximized_client(outer, def_client, 12, None), work);
+
+    // A taskbar on the left or top moves the work area's origin.
+    let work = Edges::new(62, 48, 1920, 1080);
+    let outer = inflate(work, 8);
+    assert_eq!(maximized_client(outer, deflate(outer, STANDARD_100), 8, Some(work)), work);
+}
+
+#[test]
+fn maximizing_onto_a_display_of_another_scale_cuts_nothing_off() {
+    // Win+Shift+Arrow from a 100% display to a 150% one: Windows hangs the 150% frame (12 px) off
+    // the new display while the window still reports 100% (an 8 px frame).
+    let work = Edges::new(1920, 0, 4480, 1380);
+    let outer = inflate(work, 12);
+    let def_client = deflate(outer, STANDARD_150);
+    let fallback = maximized_client(outer, def_client, 8, None);
+    assert_eq!(fallback.top, -4, "the old scale's border alone leaves 4 px under the screen's top edge");
+    assert_eq!(maximized_client(outer, def_client, 8, Some(work)), work, "the work area fixes it");
+}
+
+#[test]
+fn a_maximized_window_capped_below_the_display_keeps_its_rect() {
+    // A maximum track size smaller than the display: the window does not reach the work area's
+    // edges, so the client area is its whole rect.
+    let work = Edges::new(0, 0, 1920, 1040);
+    let outer = Edges::new(200, 100, 1000, 700);
+    assert_eq!(maximized_client(outer, deflate(outer, STANDARD_100), 8, Some(work)), outer);
+    // A work area the window does not touch at all (a stale query): the default rect.
+    let elsewhere = Edges::new(5000, 0, 6000, 1000);
+    assert_eq!(maximized_client(outer, deflate(outer, STANDARD_100), 8, Some(elsewhere)), Edges::new(208, 108, 992, 692));
+}
+
+#[test]
+fn the_top_band_resizes_and_the_buttons_answer_at_100_percent() {
+    let c = caption();
+    let hit = |x, y, zoomed, resizable| client_hit(&c, 1360, 1.0, 8, zoomed, resizable, (x, y));
+    assert_eq!(hit(2, 3, false, true), ClientHit::TopLeft);
+    assert_eq!(hit(600, 0, false, true), ClientHit::Top);
+    assert_eq!(hit(600, 7, false, true), ClientHit::Top);
+    assert_eq!(hit(1355, 3, false, true), ClientHit::TopRight, "the corner resizes over the close button");
+    assert_eq!(hit(600, 8, false, true), ClientHit::Client, "below the band is the app's own title bar");
+    // Close, then Maximize, then Minimize from the right, 46 px each.
+    assert_eq!(hit(1355, 20, false, true), ClientHit::Button(CaptionButton::Close));
+    assert_eq!(hit(1314, 20, false, true), ClientHit::Button(CaptionButton::Close));
+    assert_eq!(hit(1313, 20, false, true), ClientHit::Button(CaptionButton::Maximize));
+    assert_eq!(hit(1250, 20, false, true), ClientHit::Button(CaptionButton::Minimize));
+    assert_eq!(hit(1221, 20, false, true), ClientHit::Client);
+    assert_eq!(hit(1355, 36, false, true), ClientHit::Client, "under the title bar");
+    // Maximized: no resize band, the buttons reach the top edge (Fitts).
+    assert_eq!(hit(600, 3, true, true), ClientHit::Client);
+    assert_eq!(hit(1355, 0, true, true), ClientHit::Button(CaptionButton::Close));
+    // A window that does not resize has no band.
+    assert_eq!(hit(600, 3, false, false), ClientHit::Client);
+}
+
+#[test]
+fn the_top_band_resizes_and_the_buttons_answer_at_150_percent() {
+    let c = caption();
+    // 1360 points wide is 2040 pixels; the band is 12 px, the buttons 69 px wide and 54 tall.
+    let hit = |x, y| client_hit(&c, 2040, 1.5, 12, false, true, (x, y));
+    assert_eq!(hit(5, 5), ClientHit::TopLeft);
+    assert_eq!(hit(1000, 11), ClientHit::Top);
+    assert_eq!(hit(2035, 5), ClientHit::TopRight);
+    assert_eq!(hit(1000, 12), ClientHit::Client);
+    assert_eq!(hit(2000, 30), ClientHit::Button(CaptionButton::Close));
+    assert_eq!(hit(1971, 30), ClientHit::Button(CaptionButton::Close));
+    assert_eq!(hit(1970, 30), ClientHit::Button(CaptionButton::Maximize));
+    assert_eq!(hit(1902, 30), ClientHit::Button(CaptionButton::Maximize));
+    assert_eq!(hit(1901, 30), ClientHit::Button(CaptionButton::Minimize));
+    assert_eq!(hit(2000, 53), ClientHit::Button(CaptionButton::Close));
+    assert_eq!(hit(2000, 54), ClientHit::Client);
+}
+
+#[test]
+fn a_disabled_or_hidden_button_is_client() {
+    let no_max = Caption { maximizable: false, ..caption() };
+    assert_eq!(client_hit(&no_max, 1360, 1.0, 8, false, true, (1300, 20)), ClientHit::Client);
+    let full_screen = Caption { hidden: true, ..caption() };
+    assert_eq!(client_hit(&full_screen, 1360, 1.0, 8, true, true, (1355, 20)), ClientHit::Client);
+}
