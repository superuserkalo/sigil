-    std::fs::read(path).map_err(|e| ImageError(format!("{}: {e}", path.display())))
+    use std::io::Read;
+    let error = |e: std::io::Error| ImageError(format!("{}: {e}", path.display()));
+    let mut head = Vec::with_capacity(HEAD_BYTES.min(64 << 10));
+    std::fs::File::open(path).map_err(error)?.take(HEAD_BYTES as u64).read_to_end(&mut head).map_err(error)?;
