+/// Whether the first [`HEAD_BYTES`] of a file are enough to read its size, or what refuses it.
+#[cfg(not(target_arch = "wasm32"))]
+fn head_parses(head: &[u8]) -> bool {
+    is_svg(head) || avif::is_avif(head) || head.starts_with(b"icns") || match header_size(head) {
+        Ok(_) => true,
+        Err(error) => error.0.contains("decode limit"),
