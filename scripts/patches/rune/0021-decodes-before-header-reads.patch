@@ -0,0 +1,92 @@
+//! The process's decoder threads and their queue. A decode a window waits on (an image drawn,
+//! prefetched, or decoded again after its atlas copy was freed) goes ahead of a header read
+//! (`ImageCache::decode_when_drawn`'s size probe): a page that requests fifty pictures at once
+//! reads fifty headers, and the dozen on screen must not wait behind them.
+
+use std::collections::VecDeque;
+use std::sync::{Condvar, Mutex, OnceLock};
+
+use super::Job;
+
+/// Decoder threads for the process, at most one per core. Three keep a screen of thumbnails
+/// quick without a thread per core in a UI process.
+const DECODERS: usize = 3;
+
+/// Jobs waiting, by lane.
+pub(super) struct Lanes<T> {
+    decode: VecDeque<T>,
+    probe: VecDeque<T>,
+}
+
+impl<T> Default for Lanes<T> {
+    fn default() -> Self { Lanes { decode: VecDeque::new(), probe: VecDeque::new() } }
+}
+
+impl<T> Lanes<T> {
+    pub(super) fn push(&mut self, job: T, probe: bool) {
+        if probe { self.probe.push_back(job) } else { self.decode.push_back(job) }
+    }
+
+    /// The oldest decode, else the oldest header read.
+    pub(super) fn pop(&mut self) -> Option<T> {
+        self.decode.pop_front().or_else(|| self.probe.pop_front())
+    }
+}
+
+struct Queue {
+    lanes: Mutex<Lanes<Job>>,
+    ready: Condvar,
+}
+
+/// Queues a job: a header read (`probe`) behind every decode. The first job starts the
+/// threads, so an app that shows no image pays no thread for them; the first thread starts the
+/// others, so that job (often in a window's first frame) costs its caller one spawn, not three.
+pub(super) fn send(job: Job) {
+    static QUEUE: OnceLock<Queue> = OnceLock::new();
+    static STARTED: std::sync::Once = std::sync::Once::new();
+    let queue: &'static Queue = QUEUE.get_or_init(|| Queue { lanes: Mutex::new(Lanes::default()), ready: Condvar::new() });
+    STARTED.call_once(|| {
+        let count = DECODERS.min(std::thread::available_parallelism().map_or(1, |n| n.get()));
+        std::thread::Builder::new()
+            .name("rune-images".into())
+            .spawn(move || {
+                for _ in 1..count {
+                    let _ = std::thread::Builder::new().name("rune-images".into()).spawn(move || run(queue));
+                }
+                run(queue);
+            })
+            .expect("image worker");
+    });
+    let probe = job.probe;
+    queue.lanes.lock().unwrap_or_else(|e| e.into_inner()).push(job, probe);
+    queue.ready.notify_one();
+}
+
+fn run(queue: &Queue) {
+    loop {
+        let job = {
+            let mut lanes = queue.lanes.lock().unwrap_or_else(|e| e.into_inner());
+            loop {
+                if let Some(job) = lanes.pop() { break job; }
+                lanes = queue.ready.wait(lanes).unwrap_or_else(|e| e.into_inner());
+            }
+        };
+        super::decode_job(job);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::Lanes;
+
+    #[test]
+    fn a_decode_goes_ahead_of_every_header_read_queued_before_it() {
+        let mut lanes = Lanes::default();
+        for n in 0..50 { lanes.push(n, true); }
+        lanes.push(100, false);
+        lanes.push(101, false);
+        assert_eq!(lanes.pop(), Some(100));
+        assert_eq!(lanes.pop(), Some(101));
+        assert_eq!(lanes.pop(), Some(0), "then the header reads, oldest first");
+    }
+}
