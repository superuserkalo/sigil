{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "sigilmods.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://sigilmods.app/$1"
      }
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "src": "/",
      "headers": {
        "Link": "</index.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\""
      },
      "continue": true
    },
    {
      "src": "/([a-z0-9-]+)",
      "headers": {
        "Link": "</$1.md>; rel=\"alternate\"; type=\"text/markdown\""
      },
      "continue": true
    },
    {
      "src": "/(.*)\\.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/(llms\\.txt|llms-full\\.txt|robots\\.txt)",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/sitemap\\.xml",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "/(img|fonts)/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400"
      },
      "continue": true
    },
    {
      "src": "/(styles\\.css|site\\.js)",
      "headers": {
        "Cache-Control": "public, max-age=3600, stale-while-revalidate=86400"
      },
      "continue": true
    },
    {
      "src": "/index(\\.html)?",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/([a-z0-9-]+)\\.html",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "/([a-z0-9-]+)/",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/index.md"
    },
    {
      "src": "/([a-z0-9-]+)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/$1.md",
      "check": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/([a-z0-9-]+)",
      "dest": "/$1.html",
      "check": true
    },
    {
      "handle": "error"
    },
    {
      "src": "/.*",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "status": 404,
      "dest": "/404.md"
    }
  ]
}
